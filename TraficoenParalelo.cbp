<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TraficoenParalelo" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="target/debug/TraficoenParalelo" prefix_auto="1" extension_auto="1" />
				<Option object_output="target/debug/obj/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
                    <Add option="-std=c17" />
                    <Add option="-g" />
                    <Add option="-O0" />
                    <Add option="-DDEBUG" />
                    <Add option="-fsanitize=address,undefined" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="target/release/TraficoenParalelo" prefix_auto="1" extension_auto="1" />
				<Option object_output="target/release/obj/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
                    <Add option="-std=c17" />
                    <Add option="-O3" />
                    <Add option="-DNDEBUG" />
                    <Add option="-march=native" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
            <Add option="-Wextra" />
            <Add option="-Wpedantic" />
            <Add option="-fopenmp" />
		</Compiler>
		<Unit filename="include/auto.h" />
		<Unit filename="include/mapa.h" />
		<Unit filename="src/auto.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/mapa.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
